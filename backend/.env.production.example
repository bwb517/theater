# Copy to backend/.env on the server and fill in values

ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL connection (matches the postgres service in docker-compose.yml).
# POSTGRES_PASSWORD must also be set in the shell environment used by docker-compose
# so that ${POSTGRES_PASSWORD} in docker-compose.yml is resolved correctly.
DATABASE_URL=postgresql://theater:${POSTGRES_PASSWORD}@postgres:5432/theater
POSTGRES_PASSWORD=change-this-to-a-random-password

# Before starting the backend for the first time (or after adding new migrations):
#   docker compose exec backend alembic upgrade head
# Or, from the backend/ directory with a venv activated:
#   alembic upgrade head

# Replace with your server's IP (e.g. http://65.21.44.12)
FRONTEND_URL=http://YOUR_SERVER_IP
