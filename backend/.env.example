# THEATER Platform — Environment Configuration
# Copy to .env and fill in your values

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# Auth
# Generate a strong value: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-random-64-byte-value
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# App
DATABASE_URL=sqlite:///./theater.db
FRONTEND_URL=http://localhost:3000

# Seeding — leave unset in production. Set to true ONLY for local dev to create
# the well-known demo accounts (admin/gamemaster/player1, pw: theater123).
SEED_DEMO_USERS=
